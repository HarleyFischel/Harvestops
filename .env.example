# Demo mode is the only mode that runs without an external identity/database.
APP_ENV=development
DEMO_MODE=true
STORAGE_MODE=demo
SECRET_KEY=generate-a-long-random-value
DISPLAY_TIMEZONE=America/New_York

# SQL Server/Azure SQL mode. Do not use TrustServerCertificate in production.
SQL_SERVER=host.example.internal,1433
SQL_DATABASE=HarvestOps
SQL_USER=harvestops_app
SQL_PASSWORD=replace-me
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT=5

# Identity: demo or entra. Production rejects demo mode.
IDENTITY_MODE=demo
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=http://localhost:8050/auth/callback

# Optional answer provider; local search always works without these.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest
