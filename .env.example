# Demo mode is the only mode that runs without an external identity/database.
APP_ENV=development
DEMO_MODE=true
STORAGE_MODE=demo
SECRET_KEY=generate-a-long-random-value
DISPLAY_TIMEZONE=America/New_York

# SQL Server/Azure SQL mode. Do not use TrustServerCertificate in production.
SQL_SERVER=host.example.internal,1433
SQL_DATABASE=HarvestOps
SQL_AUTH_MODE=sql_login
SQL_USER=harvestops_app
SQL_PASSWORD=replace-me
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_CONNECTION_TIMEOUT=5
# Azure SQL managed identity mode omits SQL_USER/SQL_PASSWORD and uses AZURE_CLIENT_ID.
AZURE_CLIENT_ID=

# Required for production/multi-worker sessions; leave blank for the local demo.
SESSION_REDIS_URL=

# Identity: demo or entra. Production rejects demo mode.
IDENTITY_MODE=demo
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=http://localhost:8050/auth/callback

# Optional answer provider; local search always works without these.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

# Delivery & Quality evidence. The snapshot works without a token; the token is
# server-side only and must be a least-privilege read-only token for this repo.
EVIDENCE_SNAPSHOT_PATH=evidence/snapshot.json
GITHUB_REPOSITORY=HarleyFischel/Harvestops
GITHUB_API_URL=https://api.github.com
GITHUB_EVIDENCE_TOKEN=
GITHUB_EVIDENCE_TIMEOUT=5
EVIDENCE_CACHE_SECONDS=300

# Safe build identity passed at image build/deployment time. Unknown is valid
# for source runs without Git metadata; never infer a deployed commit.
HARVESTOPS_VERSION=0.1.0
HARVESTOPS_COMMIT=unknown
HARVESTOPS_BUILD_TIMESTAMP=unknown
HARVESTOPS_ENVIRONMENT=development
HARVESTOPS_IMAGE_DIGEST=unknown
