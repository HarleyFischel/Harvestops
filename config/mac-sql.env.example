# Temporary Apple Silicon development profile: SQL Server is linux/amd64 under emulation.
# Generate .env.mac-sql with scripts/init-mac-sql-env.sh; do not commit that file.
COMPOSE_PROJECT_NAME=harvestops-mac-sql
HARVESTOPS_MAC_SQL_APP_PORT=8051
SQL_DATABASE=HarvestOps
MSSQL_SA_PASSWORD=generate-with-init-script
HARVESTOPS_APP_LOGIN=harvestops_app
HARVESTOPS_APP_PASSWORD=generate-with-init-script
