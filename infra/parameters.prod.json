{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "appName": { "value": "harvestops-prod" },
    "image": { "value": "replace-with-production-immutable-acr-image-digest" },
    "sqlServerFqdn": { "value": "replace-with-production-sql-server.database.windows.net" },
    "sqlAuthMode": { "value": "azure_identity" },
    "sqlUser": { "value": "" },
    "acrName": { "value": "replacewithproductionacrname" },
    "keyVaultName": { "value": "replace-with-production-key-vault" },
    "sqlPasswordSecretUri": { "value": "" },
    "sessionRedisUrlSecretUri": { "value": "https://replace-with-production-key-vault.vault.azure.net/secrets/harvestops-session-redis-url" },
    "secretKeySecretUri": { "value": "https://replace-with-production-key-vault.vault.azure.net/secrets/harvestops-secret-key" },
    "entraClientSecretSecretUri": { "value": "https://replace-with-production-key-vault.vault.azure.net/secrets/harvestops-entra-client-secret" },
    "entraClientId": { "value": "replace-with-production-entra-client-id" },
    "entraTenantId": { "value": "replace-with-entra-tenant-id" },
    "entraRedirectUri": { "value": "https://replace-with-production-app-host/auth/callback" }
  }
}
